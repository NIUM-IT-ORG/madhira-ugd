# Copy to .env and fill in. Keep .env private (it holds passwords).

# Web address people will use, e.g. ugd.madhira.example.in (its DNS must point at this server).
DOMAIN=ugd.example.in

# Database password (any long random text).
DB_PASSWORD=change-me-long-random

# Secret that signs sign-in sessions (any long random text; changing it signs everyone out).
JWT_SECRET=change-me-another-long-random

# Starting accounts (Commissioner, AEE, Field Inspector) come from deploy/initial-users.json on the very
# first start; their one-time passwords are in the user guides and must be changed at first sign-in.
